# Local development: run `python3 scripts/generate-env.py` to create a real `.env`.
APP_ENV=development
SERVICE_BASE64_64_APP_ENCRYPTION_KEY=replace-with-a-64-character-generated-secret
SERVICE_BASE64_64_DASHBOARD_JWT_SECRET=replace-with-a-different-64-character-generated-secret
PUBLIC_JWT_PRIVATE_KEY_B64=replace-with-base64-encoded-rsa-private-key-pem
DASHBOARD_JWT_TTL_SECONDS=28800
DASHBOARD_ASSET_DIR=/app/data/dashboard-assets

SERVICE_PASSWORD_64_POSTGRES=replace-with-a-64-character-generated-postgres-password

REDIS_URL=redis://redis:6379/0

SERVICE_PASSWORD_64_CLICKHOUSE=replace-with-a-64-character-generated-clickhouse-password
