APP_ENV=development
APP_ENCRYPTION_KEY=replace-with-a-32-byte-minimum-secret
DASHBOARD_JWT_SECRET=replace-with-a-different-32-byte-minimum-secret
PUBLIC_JWT_SECRET=replace-with-another-32-byte-minimum-secret
DASHBOARD_JWT_TTL_SECONDS=28800
DASHBOARD_ASSET_DIR=/app/data/dashboard-assets
PASSPORT_AUTH_VOLUME_PREFIX=passport-auth

POSTGRES_DB=passport_auth
POSTGRES_USER=passport
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

REDIS_URL=redis://redis:6379/0

CLICKHOUSE_DB=passport_auth
CLICKHOUSE_USER=passport
CLICKHOUSE_PASSWORD=replace-with-a-strong-clickhouse-password
